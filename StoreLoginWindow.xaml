<Window x:Class="BFV_FPS_Monitor.StoreLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource Store.Title}"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="14,10,14,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="{DynamicResource Store.Hint}" FontSize="12.5"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StateText" FontSize="11.5" Foreground="{StaticResource AccentGreen}"
                           Margin="16,0,0,0" VerticalAlignment="Center" Text=""/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ClearBtn" Content="{DynamicResource Store.Clear}" Style="{StaticResource OverlayToggle}" Click="ClearBtn_Click"
                        ToolTip="{DynamicResource Store.TipClear}"/>
                <Button x:Name="OpenExternalBtn" Content="{DynamicResource Store.OpenExt}" Style="{StaticResource OverlayToggle}" Margin="8,0,0,0" Click="OpenExternalBtn_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FF0B0D11">
            <wv2:WebView2 x:Name="Web"/>
        </Border>
    </Grid>
</Window>
