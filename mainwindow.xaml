<Window x:Class="BFV_FPS_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BFV_FPS_Monitor"
        Title="{DynamicResource Main.Title}"
        Icon="logo.png"
        Width="1060" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="HBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Background" Value="{StaticResource BgChip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Game Monitor" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource BgChip}" CornerRadius="6" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="VerChip" Text="V1.0.0.3" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="TileBtn" Content="{DynamicResource Tile.BtnOff}" Click="TileBtn_Click"
                        Background="{StaticResource BgChip}" Foreground="{StaticResource TextPrimary}"
                        BorderThickness="0" Padding="12,5" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Tip.TileBtn}"/>
                <Button x:Name="OverlayBtn" Content="{DynamicResource Overlay.BtnOff}" Click="OverlayBtn_Click"
                        Background="{StaticResource BgChip}" Foreground="{StaticResource TextPrimary}"
                        BorderThickness="0" Padding="12,5" FontSize="12" Cursor="Hand"
                        ToolTip="{DynamicResource Tip.OverlayBtn}"/>
                <Border Background="{StaticResource BgChip}" CornerRadius="12" Padding="10,4" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ChipGameDot" Width="8" Height="8" Fill="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChipGameText" Text="{DynamicResource Main.NoGame}" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ===== Tab 导航 ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,2">
            <RadioButton x:Name="TabOverview" Style="{StaticResource TabBtn}" Content="{DynamicResource Tab.Overview}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked" Tag="overview"/>
            <RadioButton Style="{StaticResource TabBtn}" Content="{DynamicResource Tab.Details}" GroupName="tabs" Checked="Tab_Checked" Margin="6,0,0,0" Tag="details"/>
            <RadioButton Style="{StaticResource TabBtn}" Content="{DynamicResource Tab.Charts}" GroupName="tabs" Checked="Tab_Checked" Margin="6,0,0,0" Tag="charts"/>
            <RadioButton Style="{StaticResource TabBtn}" Content="{DynamicResource Tab.Sessions}" GroupName="tabs" Checked="Tab_Checked" Margin="6,0,0,0" Tag="sessions"/>
            <RadioButton Style="{StaticResource TabBtn}" Content="{DynamicResource Tab.FreeGames}" GroupName="tabs" Checked="Tab_Checked" Margin="6,0,0,0" Tag="freegames"/>
            <RadioButton Style="{StaticResource TabBtn}" Content="{DynamicResource Tab.Settings}" GroupName="tabs" Checked="Tab_Checked" Margin="6,0,0,0" Tag="settings"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <!-- ======== Tab 1 概览 ======== -->
            <Grid x:Name="PageOverview">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="3">
                    <!-- GPU 卡 -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ov.GpuTitle}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="GpuTempText" Style="{StaticResource BigValue}" Text="--"/>
                                <TextBlock Text="°C" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="3,0,0,7"/>
                                <TextBlock x:Name="GpuLoadPctText" Text="-- %" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="14,0,0,7"/>
                            </StackPanel>
                            <ProgressBar x:Name="GpuLoadBar" Style="{StaticResource HBar}" Margin="0,10,0,3"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Ov.GpuLoad}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="GpuLoadText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="GpuMemBar" Style="{StaticResource HBar}" Margin="0,8,0,3"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Ov.Vram}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="GpuMemText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="GpuNameText" Text="—" Style="{StaticResource ChipText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuClockText" Text="" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- CPU 卡 -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ov.CpuTitle}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CpuTempText" Style="{StaticResource BigValue}" Text="--"/>
                                <TextBlock Text="°C" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="3,0,0,7"/>
                                <TextBlock x:Name="CpuLoadPctText" Text="-- %" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="14,0,0,7"/>
                            </StackPanel>
                            <ProgressBar x:Name="CpuLoadBar" Style="{StaticResource HBar}" Margin="0,10,0,3"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Ov.CpuLoad}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="CpuLoadText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="RamBar" Style="{StaticResource HBar}" Margin="0,8,0,3"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Ov.Ram}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="RamText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="CpuPowerText" Text="" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="CpuClkText" Text="" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- FPS 卡 -->
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock x:Name="FpsCardTitle" Text="{DynamicResource Ov.FpsTitle}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FpsText" Style="{StaticResource BigValue}" Text="--"/>
                                <TextBlock Text="FPS" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="6,0,0,7"/>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Ov.FrameTime}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="FrameTimeText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource Ov.FrameCount}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="FrameCountText" Text="0" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource Ov.SnapTime}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="SnapTimeText" Text="--:--:--" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ov.FpsStats}" Style="{StaticResource PanelTitle}"/>
                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="AvgFpsText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                    <TextBlock Text="{DynamicResource Ov.AvgFps}" Style="{StaticResource ChipText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="P1LowText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                    <TextBlock Text="1% Low" Style="{StaticResource ChipText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="P01LowText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                                    <TextBlock Text="0.1% Low" Style="{StaticResource ChipText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="FpsNowText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    <TextBlock Text="{DynamicResource Ov.FpsNow}" Style="{StaticResource ChipText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,10"/>
                            <TextBlock Text="{DynamicResource Ov.RunState}" Style="{StaticResource PanelTitle}"/>
                            <TextBlock x:Name="RunStateText" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Text="{DynamicResource Run.Waiting}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{DynamicResource Run.AutoDetectHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ov.NetDiskBatt}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="↓" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="NetDownText" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Ov.Download}" Style="{StaticResource ChipText}"/>
                                </StackPanel>
                                <TextBlock Text="↑" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="24,0,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="NetUpText" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{DynamicResource Ov.Upload}" Style="{StaticResource ChipText}"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource Ov.DiskIo}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="DiskText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource Ov.DiskTemp}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="DiskTempText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource Ov.Battery}" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="BatteryText" Text="N/A" Style="{StaticResource ChipText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======== Tab 2 硬件详情（游戏加加风格：左档案 + 右实时） ======== -->
            <ScrollViewer x:Name="PageDetails" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：硬件档案 -->
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Det.Title}" Style="{StaticResource PanelTitle}"/>
                            <TextBlock x:Name="StOsText" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="—"/>
                            <TextBlock x:Name="StMachineText" Style="{StaticResource ChipText}" Margin="0,2,0,12" Text=""/>
                            <Grid x:Name="StGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 右：传感器实时 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Det.Sensors}" Style="{StaticResource PanelTitle}"/>
                                    <StackPanel x:Name="TempBarsHost"/>
                                    <Grid x:Name="DetailGrid" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>

            <!-- ======== Tab 3 实时曲线 ======== -->
            <Grid x:Name="PageCharts" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Chart.Fps}" Style="{StaticResource PanelTitle}"/>
                            <TextBlock x:Name="FpsRangeText" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ChipText}" Text=""/>
                        </DockPanel>
                        
                        <controls:ChartPlot x:Name="FpsChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            xmlns:controls="clr-namespace:BFV_FPS_Monitor"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Chart.CpuLoad}" Style="{StaticResource PanelTitle}"/>
                            <controls:ChartPlot x:Name="CpuChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="10,0,0,10" Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Chart.GpuLoad}" Style="{StaticResource PanelTitle}"/>
                            <controls:ChartPlot x:Name="GpuChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,10,10" Grid.Row="1" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Chart.CpuTemp}" Style="{StaticResource PanelTitle}"/>
                            <controls:ChartPlot x:Name="CpuTempChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="10,0,0,10" Grid.Row="1" Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Chart.GpuTemp}" Style="{StaticResource PanelTitle}"/>
                            <controls:ChartPlot x:Name="GpuTempChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0" Grid.Row="2" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Chart.Ram}" Style="{StaticResource PanelTitle}"/>
                            <controls:ChartPlot x:Name="RamChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="10,0,0,0" Grid.Row="2" Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Chart.Vram}" Style="{StaticResource PanelTitle}"/>
                            <controls:ChartPlot x:Name="GpuMemChart" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======== Tab 3.5 性能统计（游戏加加风格会话列表） ======== -->
            <Grid x:Name="PageSessions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="{DynamicResource Ses.Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionSummaryText" Style="{StaticResource ChipText}" Margin="12,0,0,0" VerticalAlignment="Center" Text=""/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="SessionsRefreshBtn" Content="{DynamicResource Ses.Refresh}" Style="{StaticResource OverlayToggle}" Click="SessionsRefreshBtn_Click"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SessionsHost"/>
                </ScrollViewer>
            </Grid>

            <!-- ======== Tab 5 喜加一 ======== -->
            <Grid x:Name="PageFreeGames" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="{DynamicResource Free.Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FreeCountText" Style="{StaticResource ChipText}" Margin="12,0,0,0" VerticalAlignment="Center" Text=""/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="FreeRefreshBtn" Content="{DynamicResource Free.Refresh}" Style="{StaticResource OverlayToggle}" Click="FreeRefreshBtn_Click"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FreeHintText" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="2,0,2,10" TextWrapping="Wrap"
                                   Text="{DynamicResource Free.Hint}"/>
                        <StackPanel x:Name="FreeGamesHost"/>
                        <TextBlock x:Name="FreeStatusText" Style="{StaticResource ChipText}" Margin="2,12,0,0" Text=""/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== Tab 4 设置 ======== -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set.Process}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <CheckBox x:Name="AutoDetectChk" Content="{DynamicResource Set.AutoDetect}" Foreground="{StaticResource TextPrimary}" IsChecked="True"/>
                                <TextBlock Text="{DynamicResource Set.AutoDetectHint}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Set.PinLabel}" Style="{StaticResource ChipText}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ProcCombo" Style="{StaticResource DarkCombo}" Width="240" MinHeight="30"/>
                                <Button x:Name="PinBtn" Content="{DynamicResource Set.Pin}" Style="{StaticResource OverlayToggle}" Margin="8,0,0,0" Click="PinBtn_Click"/>
                                <Button x:Name="UnpinBtn" Content="{DynamicResource Set.Unpin}" Style="{StaticResource OverlayToggle}" Margin="6,0,0,0" Click="UnpinBtn_Click"/>
                                <Button x:Name="RefreshProcBtn" Content="{DynamicResource Set.RefreshList}" Style="{StaticResource OverlayToggle}" Margin="6,0,0,0" Click="RefreshProcBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set.Osd}" Style="{StaticResource PanelTitle}"/>
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Set.OsdItems}" Style="{StaticResource ChipText}" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="OsdFps" Content="FPS" Foreground="{StaticResource TextPrimary}"/>
                                    <CheckBox x:Name="OsdCpuL" Content="{DynamicResource Set.OsdCpuL}" Foreground="{StaticResource TextPrimary}"/>
                                    <CheckBox x:Name="OsdCpuT" Content="{DynamicResource Set.OsdCpuT}" Foreground="{StaticResource TextPrimary}"/>
                                    <CheckBox x:Name="OsdGpuL" Content="{DynamicResource Set.OsdGpuL}" Foreground="{StaticResource TextPrimary}"/>
                                    <CheckBox x:Name="OsdGpuT" Content="{DynamicResource Set.OsdGpuT}" Foreground="{StaticResource TextPrimary}"/>
                                    <CheckBox x:Name="OsdNet" Content="{DynamicResource Set.OsdNet}" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Set.OsdAppearance}" Style="{StaticResource ChipText}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{DynamicResource Set.OsdPos}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="42"/>
                                        <ComboBox x:Name="OsdCornerCombo" Style="{StaticResource DarkCombo}" Width="150" MinHeight="28"
                                                  SelectionChanged="OsdSetting_Changed">
                                            <ComboBoxItem>{DynamicResource Set.OsdCorner1}</ComboBoxItem>
                                            <ComboBoxItem>{DynamicResource Set.OsdCorner2}</ComboBoxItem>
                                            <ComboBoxItem>{DynamicResource Set.OsdCorner3}</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="{DynamicResource Set.OsdFontSize}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="42"/>
                                        <Slider x:Name="OsdFontSlider" Width="120" Minimum="10" Maximum="22" Value="14"
                                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OsdSetting_Changed"/>
                                        <TextBlock x:Name="OsdFontVal" Text="14" Style="{StaticResource ChipText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="{DynamicResource Set.OsdOpacity}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="62"/>
                                        <Slider x:Name="OsdOpacitySlider" Width="100" Minimum="30" Maximum="100" Value="90"
                                                TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OsdSetting_Changed"/>
                                        <TextBlock x:Name="OsdOpacityVal" Text="90%" Style="{StaticResource ChipText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set.Tile}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{DynamicResource Set.TileStyle}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="88"/>
                                <ComboBox x:Name="TileStyleCombo" Style="{StaticResource DarkCombo}" Width="190" MinHeight="30" SelectionChanged="TileStyle_Changed">
                                    <ComboBoxItem>{DynamicResource Set.TileStyle0}</ComboBoxItem>
                                    <ComboBoxItem>{DynamicResource Set.TileStyle1}</ComboBoxItem>
                                    <ComboBoxItem>{DynamicResource Set.TileStyle2}</ComboBoxItem>
                                    <ComboBoxItem>{DynamicResource Set.TileStyle3}</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="TileClickThroughChk" Content="{DynamicResource Set.TileClickThrough}" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"
                                      Checked="TileOpt_Changed" Unchecked="TileOpt_Changed"/>
                            <CheckBox x:Name="TileTaskbarChk" Content="{DynamicResource Set.TileTaskbar}" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0"
                                      Checked="TileOpt_Changed" Unchecked="TileOpt_Changed"/>
                            <CheckBox x:Name="TileMiniChk" Content="{DynamicResource Set.TileMini}" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0"
                                      Checked="TileOpt_Changed" Unchecked="TileOpt_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="TileResetPosBtn" Content="{DynamicResource Set.TileResetPos}" Style="{StaticResource OverlayToggle}" Click="TileResetPosBtn_Click"/>
                                <TextBlock Text="{DynamicResource Set.TileDragHint}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set.Collect}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{DynamicResource Set.PollInterval}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="88"/>
                                <Slider x:Name="HwPollSlider" Width="140" Minimum="500" Maximum="5000" Value="1000"
                                        TickFrequency="250" IsSnapToTickEnabled="True" ValueChanged="HwPoll_Changed"/>
                                <TextBlock x:Name="HwPollVal" Text="1000ms" Style="{StaticResource ChipText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <TextBlock Text="{DynamicResource Set.CsvLog}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="88"/>
                                <ComboBox x:Name="CsvModeCombo" Style="{StaticResource DarkCombo}" Width="150" MinHeight="30" SelectionChanged="CsvMode_Changed">
                                    <ComboBoxItem>{DynamicResource Set.CsvOff}</ComboBoxItem>
                                    <ComboBoxItem>{DynamicResource Set.CsvFrame}</ComboBoxItem>
                                    <ComboBoxItem>{DynamicResource Set.CsvSec}</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Set.CsvFile}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set.System}" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                <TextBlock Text="{DynamicResource Set.Language}" Style="{StaticResource ChipText}" VerticalAlignment="Center" Width="88"/>
                                <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkCombo}" Width="150" MinHeight="30" SelectionChanged="Language_Changed">
                                    <ComboBoxItem Tag="zh-CN">{DynamicResource Lang.ZhName}</ComboBoxItem>
                                    <ComboBoxItem Tag="en-US">{DynamicResource Lang.EnName}</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Lang.Hint}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutostartChk" Content="{DynamicResource Set.Autostart}" Foreground="{StaticResource TextPrimary}"
                                      Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                            <CheckBox x:Name="SessionPopupChk" Content="{DynamicResource Set.SessionPopup}" Foreground="{StaticResource TextPrimary}"
                                      Checked="SessionPopup_Changed" Unchecked="SessionPopup_Changed"/>
                            <Button x:Name="SnapshotBtn" Content="{DynamicResource Set.SnapshotBtn}" Style="{StaticResource OverlayToggle}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="SnapshotBtn_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" FontSize="11"
                   Foreground="{StaticResource TextSecondary}"
                   Text="{DynamicResource Status.Starting}"/>
    </Grid>
</Window>
